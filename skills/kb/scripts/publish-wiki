#!/bin/sh
# Publish one reviewed commit from an isolated Wiki clone.
set -eu

if [ "$#" -ne 1 ]; then
  echo "Usage: publish-wiki <wiki-clone>" >&2
  exit 2
fi

cd "$1"
if [ -n "$(git status --porcelain)" ]; then
  echo "kb: commit the reviewed diff in the Wiki clone first" >&2
  exit 1
fi

upstream_ref=$(git symbolic-ref refs/remotes/origin/HEAD)
branch=${upstream_ref#refs/remotes/origin/}
push_refspec="HEAD:refs/heads/$branch"
base=$(git rev-parse "$upstream_ref")

head=$(git rev-parse HEAD)
if [ "$(git rev-list --parents -n 1 HEAD)" != "$head $base" ]; then
  echo "kb: expected one reviewed commit on the checked-out Wiki base" >&2
  exit 1
fi

if git push --no-follow-tags origin "$push_refspec"; then
  exit 0
fi

if ! git fetch origin; then
  echo "kb: fetch failed; draft retained in $PWD" >&2
  exit 1
fi
latest=$(git rev-parse "$upstream_ref")
if git merge-base --is-ancestor HEAD "$latest"; then
  exit 0
fi
if [ "$latest" = "$base" ] || ! git merge-base --is-ancestor "$base" "$latest"; then
  echo "kb: push failed; review the draft in $PWD" >&2
  exit 1
fi

if git -c rerere.enabled=false rebase "$upstream_ref"; then
  if git push --no-follow-tags origin "$push_refspec"; then
    exit 0
  fi
else
  git rebase --abort
fi

echo "kb: publication failed; draft retained in $PWD" >&2
exit 1
